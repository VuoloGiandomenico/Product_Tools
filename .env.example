# =========================================================================
# PO Tools Connection Credentials Config Template
# Copy this file to '.env' and fill in your actual credentials.
# The '.env' file is ignored by Git to keep your credentials secure.
# =========================================================================

# --- JIRA CONFIGURATION ---
# Your Jira Server Base URL (e.g. Jira Cloud or Jira Server)
JIRA_SERVER=https://your-company.atlassian.net

# Your secure Jira Personal Access Token (PAT)
JIRA_API_TOKEN=your_jira_pat_here


# --- CONFLUENCE CONFIGURATION ---
# Your Confluence Server Base URL (e.g., https://your-company.atlassian.net/wiki or Server URL)
CONFLUENCE_SERVER=https://your-company.atlassian.net/confluence

# Your secure Confluence Personal Access Token (PAT)
CONFLUENCE_API_TOKEN=your_confluence_pat_here

# Default Confluence Space Key (e.g., DS)
CONFLUENCE_SPACE=DS

# Default Confluence Page Title (e.g., Release Notes)
CONFLUENCE_PAGE=Release Notes

# Default Confluence Page Title for Sprint KPIs
CONFLUENCE_KPI_PAGE=70_Project KPIs


# --- PROJECT & BRANDING CONFIGURATION ---
# Project / Company Name
PROJECT_NAME=PO Tools Enterprise

# Primary Color Theme Hex (e.g., #3B82F6)
PRIMARY_COLOR=#3B82F6

# Default Overview Sprint Number / Name (for Step 1 Overview query)
OVERVIEW_SPRINT_NUM=1

# Default Outlook Sprint Number / Name (for Step 1 Outlook query)
OUTLOOK_SPRINT_NUM=2

# Default Cover Page Sprint name (e.g., Sprint 14)
COVER_SPRINT_NAME=Sprint 14

# Default logo image file path (leave blank to use streamlit uploader)
LOGO_IMAGE_PATH=

# Default cover page image file path (leave blank to use streamlit uploader)
COVER_IMAGE_PATH=

# Default Welcome Message Content (displays on the PDF cover page)
SPRINT_WELCOME_MESSAGE=Welcome to the Sprint Review session. This document consolidates our delivered sprint capabilities, scheduled target releases, and interactive product demo presentations. We thank our engineering team and product stakeholders for their collaborative efforts.

# Default Introduction Content (Support raw markdown text with \n for newlines)
RELEASE_NOTES_INTRO=### Dear Users & Partners,\n\nWe are excited to share the **Release Notes** for our latest development cycle. In this iteration, our engineering team focused on bolstering platform security, optimizing database transaction queries, and releasing crucial merchant billing integrations.\n\n**Delivered Highlights:**\n* **Enhanced Security:** Implemented Google & GitHub OAuth2 Single Sign-On (SSO).\n* **Payment Processing:** Integrated recurrent merchant subscription flows via Stripe.\n* **Document Services:** Finalized robust PDF invoicing exporters inside staging.\n\nThank you for your continuous feedback, which drives our iterative development process.\n\n*Best Regards,*\n**The Product Management Team**

# --- EXPORT FILE NAMES CONFIGURATION ---
# Default export filename base for Sprint Review PDF
DEFAULT_FILENAME_SPRINT_REVIEW=Sprint_Review_Report

# Default export filename base for Release Notes PDF
DEFAULT_FILENAME_RELEASE_NOTES=Release_Notes

# --- INGESTION & JIRA FILTER CONFIGURATIONS ---
# Default Fix Version for Release Notes Ingestion
DEFAULT_FIX_VERSION=v1.3.0

# Default issue types to select/include during ingestion (comma-separated list)
DEFAULT_INCLUDED_TYPES=User Story, Task, Technical Task, Technical Sub-task, Bug

# --- TEAM LABELS CONFIGURATION ---
# Team labels used to group and sort issues in the Sprint Review (comma-separated list)
TEAM_LABELS=Frontend_Team, Backend_Team, Architecture_Team

# --- QUARTERLY EPIC PROGRESS CONFIGURATION ---
COMMITTED_LABEL=Project_committed
QUARTER_LABEL=Project_Quarter_1
QUARTER_STATUS_TABLE_TITLE=Epics Q3 - Current Progress

# --- JIRA VERSION LINK CONFIGURATION ---
JIRA_VERSION_LINK_BASE=https://your-company.atlassian.net/jira/projects/MYPROJECT/versions/

# ============================================================================
# RELEASE NOTES / CONFLUENCE HISTORY CONFIGURATION [PROJECT-SPECIFIC]
# Copy this complete .env.example file to .env, then adapt the values below for
# your project. Do not share your .env file: it contains private credentials.
# ============================================================================
# Default title shown on the Release Notes cover and page headers.
RELEASE_NOTES_DOCUMENT_TITLE=MyProject - Software Release Note
# Full Confluence URL of the page that contains the Release history table.
RELEASE_HISTORY_URL=https://your-company.atlassian.net/confluence/spaces/MYPROJECT/pages/123456789/Release+history+Documentation
# Required table columns. Change these names if another project uses different headers.
RELEASE_HISTORY_VERSION_COLUMN=Version
RELEASE_HISTORY_DEPLOY_DATE_COLUMN=Deploy Date (PROD)
RELEASE_HISTORY_SCS_COLUMN=SCS
RELEASE_HISTORY_SERVICE_CHANGE_COLUMN=VW Service Center Change
# The PDF link is added to this column when publishing the Release Note.
RELEASE_HISTORY_RELEASE_NOTES_COLUMN=PO Acceptance and release notes

# Jira query used to find known residual anomalies. Bugs assigned to the release
# currently being prepared are excluded automatically afterwards.
RESIDUAL_ANOMALIES_JQL=project = "{{PROJECT_KEY}}" AND issuetype = Bug AND status != Closed AND status != Resolved AND labels in (Severity_A, Severity_B) AND labels not in (Cognos) AND (fixVersion is EMPTY OR fixVersion not in ("{{RELEASE_FIX_VERSION}}"))

# --- KPI CONFIGURATION ---
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_SEVERITY_A_LABEL=Severity_A
JIRA_SEVERITY_B_LABEL=Severity_B
JIRA_STATUS_IN_PROGRESS=In Progress
JIRA_STATUS_ACCEPTANCE_TEST=Acceptance Test

# --- AI ISSUE CREATOR CONFIGURATION ---
OLLAMA_URL=http://localhost:11434
AI_ISSUE_MODEL=
AI_ISSUE_PROJECT_KEY=
AI_ISSUE_LABELS=
AI_ISSUE_FIX_VERSION=
AI_ISSUE_SPRINT=
AI_ISSUE_ASSIGNEE=
AI_ISSUE_STORY_POINTS=

# --- API CONFIGURATION ---
API_KEY=your_secret_api_key_here
# Base URL of the local FastAPI service used by the hub status check and the AI Agent.
LOCAL_API_URL=http://localhost:8000

# --- REMOTE ACCESS (Cloudflare collaboration tunnel) ---
# Password required for anyone opening the app through the tunnel or a proxy.
# Leave empty to block all remote access. Integration credentials can only be
# viewed or changed from the host machine (http://localhost:8501).
REMOTE_ACCESS_PASSWORD=
BUGS_CUSTOM_COLUMN_NAME="Severity"
BUGS_CUSTOM_COLUMN_LABELS="Severity_A,Severity_B,Severity_C"

# --- SONARQUBE CODE QUALITY KPIS (optional) ---
# Adds Code Smells, Security Issues and Coverage % to Sprint KPIs and to the Confluence KPI table.
# Leave any of these empty to turn the Sonar KPIs off. The token only needs Browse permission.
SONAR_SERVER=https://sonar.your-company.com
SONAR_TOKEN=
# Project, application or portfolio key whose totals are reported
SONAR_COMPONENT=

# --- SBOM INVENTORY DEPENDENCY FINDINGS KPI (optional) ---
# Adds Dependencies Findings (CVEs in dependencies, dev + prod, as on the SBOM Inventory app card).
# Create the key/secret pair in your Service Board. Leave any empty to turn it off.
SBOM_SERVER=https://sbom.your-company.com
SBOM_API_KEY=
SBOM_API_SECRET=
# IDs from the SBOM Inventory URL: /ns/<namespace id>/apps/<app id>
SBOM_NAMESPACE_ID=
SBOM_APP_ID=

# --- VANGUARD PLATFORM FINDINGS KPI (optional) ---
# Current open findings across every page, excluding previews (all severities).
# Create/activate credentials in Project > Access Management > API Credentials.
# Only POSTs to the OAuth token endpoint and GETs project findings; no resource writes.
# Leave any value empty to disable. Keep credentials only in the ignored local .env.
VANGUARD_PROJECT_ID=
VANGUARD_CLIENT_ID=
VANGUARD_CLIENT_SECRET=
# One.Cloud endpoints: OAuth token URL and API base URL (findings are read from <API URL>/projects/<id>/findings)
VANGUARD_AUTH_URL=https://auth.api.your-company.com/oauth2/token
VANGUARD_API_URL=https://api.your-company.com

# ============================================================================
# RELEASE PLAN POST-ACTIONS
# ============================================================================
# Label of the Jira fixVersion (no trailing space). The app searches for
# fixVersion = "<label> <version>". Optional; default: DIGITAL:HUB
RELEASE_FIXVERSION_LABEL=DIGITAL:HUB
# ID of the Confluence parent page whose DIRECT children are Release Plan pages.
# REQUIRED. Numeric page ID only (not a URL).
RELEASE_PLAN_PARENT_PAGE=<PARENT_PAGE_ID>
# Title of the Release Plan page to write to; {version} is replaced by the entered
# version. Optional; default: Release Plan {version}
RELEASE_PLAN_TITLE_TEMPLATE=Release Plan {version}

# ============================================================================
# RELEASE READINESS (Release Plan sandbox)
# ============================================================================
# Sandbox: typing the first version reads (read-only) the Jira issues of the second
# and allows Confluence writes ONLY to page 7570725597. Optional; comma-separated.
# RELEASE_PLAN_SANDBOX_MAP=999.0.0:35.0.0
# Optional ordered workflow statuses (comma-separated) used to decide "Acceptance Test or later".
# RELEASE_READINESS_STATUS_ORDER=
# Jira project key used by Release Readiness queries (default: RECALLTWO).
# RELEASE_PLAN_JIRA_PROJECT=
# Confluence space allowed for Release Plan writes (default: same as the Jira project).
# RELEASE_PLAN_SPACE_KEY=
# Only Confluence page writable in sandbox mode (default: 7570725597).
# RELEASE_PLAN_SANDBOX_PAGE_ID=
